{
  "name": "@orrery/core",
  "version": "0.4.5",
  "description": "Saju (四柱八字), Ziwei Doushu (紫微斗數) and Western natal chart calculations in pure TypeScript for browsers and Node.js",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rath/orrery.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rath/orrery/tree/main/packages/core#readme",
  "bugs": "https://github.com/rath/orrery/issues",
  "type": "module",
  "keywords": [
    "saju",
    "사주",
    "四柱八字",
    "bazi",
    "four-pillars",
    "ziwei",
    "자미두수",
    "紫微斗數",
    "natal-chart",
    "astrology",
    "korean-astrology",
    "chinese-astrology"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./saju": {
      "types": "./dist/saju.d.ts",
      "import": "./dist/saju.js"
    },
    "./ziwei": {
      "types": "./dist/ziwei.d.ts",
      "import": "./dist/ziwei.js"
    },
    "./natal": {
      "types": "./dist/natal.d.ts",
      "import": "./dist/natal.js"
    },
    "./timezone": {
      "types": "./dist/timezone.d.ts",
      "import": "./dist/timezone.js"
    },
    "./pillars": {
      "types": "./dist/pillars.d.ts",
      "import": "./dist/pillars.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./cities": {
      "types": "./dist/cities.d.ts",
      "import": "./dist/cities.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
